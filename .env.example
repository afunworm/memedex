# Copy to .env (used by docker compose, and by the server in local dev)

# OIDC provider and the public (PKCE) client registered for MemeDex.
# Redirect URI to register: https://<your-host>/callback
# Post-logout redirect URI: https://<your-host>
OIDC_ISSUER=https://oidc.example.com
OIDC_CLIENT_ID=

# Encrypts each user's Claude API key at rest. At least 32 characters:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

